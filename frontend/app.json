{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lumina",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0418",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.luminanatal.k74dsl",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Send a daily nudge for your horoscope and tarot pull."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3A1580"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.luminanatal.k74dsl",
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0418"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F0C560",
          "defaultChannel": "daily-reading"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
